# Copy to .env for local development:  cp .env.example .env
#
# When deploying to Streamlit Community Cloud, do NOT upload this file. Put the
# same values in the app's Secrets box instead (Settings -> Secrets), which takes
# TOML:
#
#     OPENAI_API_KEY = "sk-..."
#
# Note the quotes. An unquoted KEY=value line is not valid TOML and loads
# nothing at all, which from the outside looks exactly like "no secrets set".

# Required. Used for embeddings and for the chat model.
OPENAI_API_KEY=ADD_KEY_HERE

# Optional. Only raises the GitHub API rate limit from 60 to 5,000 requests per
# hour. Public repositories work fine without it.
GITHUB_TOKEN=
