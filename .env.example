# Copy to .env for local development:  cp .env.example .env
#
# DEPLOYING TO STREAMLIT COMMUNITY CLOUD: do NOT upload this file. Put the same
# values in the app's Secrets box (Settings -> Secrets), which takes TOML:
#
#     OPENAI_API_KEY = "sk-proj-..."
#
# The quotes matter. An unquoted KEY=value line is not valid TOML and loads
# NOTHING AT ALL - not partially - which from the outside looks identical to
# "no secrets configured". The app has a diagnostic for exactly this: when no key
# is found it lists the secret NAMES it can see (never values), so you can tell
# "the TOML did not parse" from "nothing is set".

# Required. Used for both the chat model and the embeddings.
# Use a PROJECT-SCOPED key from a dedicated OpenAI project, never an
# account-wide one, so revoking it costs you nothing else.
OPENAI_API_KEY=ADD_KEY_HERE

# Optional. Only raises the GitHub API rate limit from 60 to 5,000 requests per
# hour. Public repositories work fine without it. Needs no scopes at all.
GITHUB_TOKEN=

# Optional overrides. The defaults are pinned DATED SNAPSHOTS that must match
# the model allow-list on the OpenAI project. If you change one, change the
# allow-list too, or every request fails with model_not_found.
# CHAT_MODEL=gpt-5.4-mini-2026-03-17
# EMBEDDING_MODEL=text-embedding-3-small
